{
  "name": "pdf-studio-pro",
  "version": "1.0.2",
  "description": "Professional C++ Native Engine & Node.js PDF Editor Studio",
  "main": "main_desktop.js",
  "scripts": {
    "start": "node src/server/app.js",
    "start:web": "node src/server/app.js",
    "start:desktop": "electron main_desktop.js",
    "dist:win": "electron-builder --win",
    "dist:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "com.pdfstudio.pro",
    "productName": "PDF Studio Pro",
    "copyright": "Copyright © 2026 PDF Studio Engineering",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main_desktop.js",
      "preload.js",
      "src/**/*",
      "public/**/*",
      "sample_docs/**/*",
      ".env",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "sample_docs",
        "to": "sample_docs",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF Studio Pro",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    }
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  }
}
